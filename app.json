{
  "expo": {
    "name": "WhoseTurn",
    "slug": "whoseturn",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "whoseturn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ehsanjafarzadeh.whoseturn",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.ehsanjafarzadeh.whoseturn",
      "adaptiveIcon": {
        "backgroundColor": "#5CCB94",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5CCB94",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      "expo-apple-authentication",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2e32d9d6-d0d5-401c-9db7-7d1a6ef832bc"
      }
    },
    "owner": "ehsanjafa",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2e32d9d6-d0d5-401c-9db7-7d1a6ef832bc"
    }
  }
}
